# ═══════════════════════════════════════════════════════════════════
# LiveIQ — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://liveiq:liveiq_dev_password@localhost:5432/liveiq
POSTGRES_SYNC_URL=postgresql+psycopg2://liveiq:liveiq_dev_password@localhost:5432/liveiq
POSTGRES_PASSWORD=liveiq_dev_password

# ─── MongoDB ─────────────────────────────────────────────────────
MONGO_URL=mongodb://liveiq:liveiq_mongo_password@localhost:27017/liveiq?authSource=admin
MONGO_PASSWORD=liveiq_mongo_password
MONGO_DB_NAME=liveiq

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Auth ────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Music & Streaming APIs ──────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# ─── Events & Ticketing APIs ─────────────────────────────────────
TICKETMASTER_API_KEY=
BANDSINTOWN_APP_ID=
SONGKICK_API_KEY=
SETLISTFM_API_KEY=
EVENTBRITE_TOKEN=

# ─── Entertainment & Sports APIs ─────────────────────────────────
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
ESPN_API_KEY=
CRICBUZZ_API_KEY=

# ─── Social & News APIs ──────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=LiveIQ/1.0
NEWSAPI_KEY=
TWITTER_BEARER_TOKEN=

# ─── Geo & Maps APIs ─────────────────────────────────────────────
MAPBOX_TOKEN=
GOOGLE_PLACES_API_KEY=
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# ─── Google Trends ───────────────────────────────────────────────
# No API key needed — uses pytrends (unofficial)
PYTRENDS_LANGUAGE=en-IN
PYTRENDS_TIMEZONE=330

# ─── AI & LLM APIs ───────────────────────────────────────────────
# Groq is primary (used by executive briefings + copilot) — OpenAI-compatible API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini kept as optional fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ─── App Settings ────────────────────────────────────────────────
APP_ENV=development
APP_NAME=LiveIQ
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
